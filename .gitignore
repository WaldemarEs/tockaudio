# =============================================================================
# TOCKAUDIO STUDIO - .gitignore
# =============================================================================
# Filosofía: Proteger la confidencialidad interna y archivos de build.
# Decisión técnica: Excluir explícitamente /docs/internal/ para mantener 
# la documentación sensible (DECISIONS, KNOWN_ISSUES) fuera de GitHub.
# =============================================================================

# --- DOCUMENTACIÓN INTERNA SENSIBLE (NUNCA SUBIR) ---
/docs/internal/

# --- VARIABLES DE ENTORNO Y SECRETS ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# --- DEPENDENCIAS Y BUILD (Vite/React) ---
node_modules/
/dist/
/build/
/.vite/
/vite.config.ts.timestamp-*

# --- LOGS Y DEBUG ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- EDITORES DE CÓDIGO Y OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- TESTING Y COBERTURA ---
coverage/
.nyc_output/

# --- OTROS ---
# Si usas pnpm
.pnp
.pnp.js

# Archivos de licencias locales o scripts de generación con claves privadas
/scripts/*.key
/scripts/*.pem
